{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch MCP Server with Inspector",
            "program": "${workspaceFolder}/node_modules/.bin/mcp-inspector",
            "args": [
                "node",
                "${workspaceFolder}/dist/index.js"
            ],
            "cwd": "${workspaceFolder}",
            "outputCapture": "std",
            "console": "integratedTerminal",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
        }
    ]
}